        {
          "AssumeRole": {
            "role_arn": "arn:aws:iam::123456789:role/RoleB"
          }
        },
        {
          "AssumeRole": {
            "role_arn": "arn:aws:iam::123456789:role/RoleA"
          }
        }
      ]
    }
  },
