# This script contains additional CI checks to run for this specific package

set -e

C_RED='\033[1;31m'
C_YELLOW='\033[1;33m'
C_RESET='\033[0m'

# `--no-default-features --features sign-http,http1` compiled on 1.6.x and has no crypto backend
# here. The `compile_error!` in `crypto.rs` makes that build say what to do about it instead of
# reporting unresolved `crypto::` imports at the call sites.
#
# Asserted here because nothing else can: the condition is a feature combination, invisible to the
# test suite, and deleting the `compile_error!` breaks no build -- it only makes the failure less
# legible, a regression with no other symptom.
echo "### Checking that a build with no crypto backend explains itself"

output="$(cargo check --no-default-features --features sign-http,http1 2>&1 || true)"

if ! grep -q "requires a crypto backend" <<<"${output}"; then
    echo -e "${C_RED}A build with no crypto backend must fail with the diagnostic from crypto.rs${C_RESET}" >&2
    echo -e "${C_RED}naming the features that fix it. It did not. Output was:${C_RESET}" >&2
    echo "${output}" >&2
    exit 1
fi

# The diagnostic has to come first, which is the whole value of it: `rustc` reports a
# `compile_error!` ahead of the unresolved imports that follow from the same missing backend, so
# the consumer reads the actionable line rather than its consequences.
first_error="$(grep -m1 '^error' <<<"${output}")"
if ! grep -q "requires a crypto backend" <<<"${first_error}"; then
    echo -e "${C_RED}The crypto backend diagnostic must be the first error reported, but the first${C_RESET}" >&2
    echo -e "${C_RED}error was:${C_RESET} ${first_error}" >&2
    exit 1
fi

echo -e "${C_YELLOW}  ok: ${first_error}${C_RESET}"
