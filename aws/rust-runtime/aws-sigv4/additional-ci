# This script contains additional CI checks to run for this specific package

set -e

C_RED='\033[1;31m'
C_YELLOW='\033[1;33m'
C_RESET='\033[0m'

# Both crypto backends are optional dependencies, so a build naming neither has no crypto at all.
# That configuration is the breaking part of this crate's 2.0.0: `--no-default-features --features
# sign-http,http1` compiled on 1.6.0 and does not here. The `compile_error!` in `crypto.rs` exists
# so that the build says what to do about it instead of failing on an unresolved `hmac` import from
# inside a private module, which is what a consumer would otherwise have to diagnose.
#
# Asserted here because nothing else can. The condition is a feature combination, so it is invisible
# to the crate's own test suite; and deleting the `compile_error!` does not break any build, it only
# makes the failure less legible -- a regression with no symptom other than a worse message.
echo "### Checking that a build with no crypto backend explains itself"

output="$(cargo check --no-default-features --features sign-http,http1 2>&1 || true)"

if ! grep -q "requires a crypto backend" <<<"${output}"; then
    echo -e "${C_RED}A build with no crypto backend must fail with the diagnostic from crypto.rs${C_RESET}" >&2
    echo -e "${C_RED}naming the features that fix it. It did not. Output was:${C_RESET}" >&2
    echo "${output}" >&2
    exit 1
fi

# The diagnostic has to come first. `rustc` reports a `compile_error!` ahead of the unresolved
# imports that follow from the same missing backend, and that ordering is the whole value of it:
# the consumer reads the actionable line, not the three that are consequences.
first_error="$(grep -m1 '^error' <<<"${output}")"
if ! grep -q "requires a crypto backend" <<<"${first_error}"; then
    echo -e "${C_RED}The crypto backend diagnostic must be the first error reported, but the first${C_RESET}" >&2
    echo -e "${C_RED}error was:${C_RESET} ${first_error}" >&2
    exit 1
fi

echo -e "${C_YELLOW}  ok: ${first_error}${C_RESET}"
