{
    "smithy": "2.0",
    "shapes": {
        "ex#Empty": {
            "type": "operation",
            "input": {
                "target": "smithy.api#Unit"
            },
            "output": {
                "target": "smithy.api#Unit"
            }
        },
        "ex#Failure": {
            "type": "structure",
            "members": {},
            "traits": {
                "smithy.api#error": "client"
            }
        },
        "ex#Read": {
            "type": "operation",
            "input": {
                "target": "ex#ReadInput"
            },
            "output": {
                "target": "ex#ReadResult"
            },
            "traits": {
                "smithy.api#readonly": {}
            }
        },
        "ex#ReadInput": {
            "type": "structure",
            "members": {}
        },
        "ex#ReadResult": {
            "type": "structure",
            "members": {},
            "traits": {
                "smithy.api#output": {}
            }
        },
        "ex#Service": {
            "type": "service",
            "operations": [
                {
                    "target": "ex#Empty"
                },
                {
                    "target": "ex#Read"
                },
                {
                    "target": "ex#Write"
                }
            ]
        },
        "ex#Write": {
            "type": "operation",
            "input": {
                "target": "ex#WriteInput"
            },
            "output": {
