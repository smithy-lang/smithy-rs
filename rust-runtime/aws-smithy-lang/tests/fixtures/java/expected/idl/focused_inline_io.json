                        "smithy.api#required": {}
                    }
                }
            },
            "traits": {
                "smithy.api#documentation": "input docs",
                "smithy.api#input": {}
            }
        },
        "ex#WriteResult": {
            "type": "structure",
            "members": {
                "id": {
                    "target": "smithy.api#String"
                }
            },
            "traits": {
                "smithy.api#output": {},
                "smithy.api#sensitive": {}
            }
        }
