+    private static void countResultReferences(Rule rule, Map<String, Integer> usage) {
+        if (rule instanceof TreeRule) {
+            for (Rule nested : ((TreeRule) rule).getRules()) {
+                for (Condition condition : nested.getConditions()) {
+                    count(condition.getFunction(), usage);
+                }
+                countResultReferences(nested, usage);
+            }
+        } else if (rule instanceof EndpointRule) {
+            Endpoint endpoint = ((EndpointRule) rule).getEndpoint();
+            count(endpoint.getUrl(), usage);
+            for (List<Expression> values : endpoint.getHeaders().values()) {
+                for (Expression value : values) {
+                    count(value, usage);
+                }
+            }
+            for (Literal value : endpoint.getProperties().values()) {
+                count(value, usage);
+            }
+        } else if (rule instanceof ErrorRule) {
+            count(((ErrorRule) rule).getError(), usage);
+        }
+    }
