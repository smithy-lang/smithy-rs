//! Record the exact shared scenarios against legacy services.

use std::collections::BTreeMap;

pub use protocol_compat_mainline::kit::{from_bytes, Body};
use protocol_compat_mainline::{awsjson, cbor, document, rest};

mod support;
use support::scenarios::*;

async fn replay<S, B>(
    service: impl Fn() -> S,
    protocol: &str,
    scenarios: &[(&'static str, Build)],
) -> BTreeMap<String, String>
where
    S: tower::Service<http::Request<Body>, Response = http::Response<B>>,
    S::Error: std::fmt::Debug,
    B: http_body::Body,
    B::Error: std::fmt::Debug,
{
    let mut records = BTreeMap::new();
    for (name, build) in scenarios {
        records.insert(
            format!("{protocol}/{name}"),
            snapshot(&support::send(service(), build()).await),
        );
    }
    records
}

#[tokio::main]
async fn main() {
    let mut records = BTreeMap::new();
    records.extend(replay(rest::service, "restJson1", &rest_scenarios()).await);
    records.extend(replay(awsjson::service, "awsJson1_0", &aws_json_scenarios()).await);
    records.extend(replay(cbor::service, "rpcv2Cbor", &cbor_scenarios()).await);
    records.extend(
        replay(
            document::service,
            "restJson1-document",
            &document_scenarios(),
        )
        .await,
    );
    let path = std::env::args_os().nth(1).expect("output snapshot path");
    std::fs::write(path, serde_json::to_string_pretty(&records).unwrap() + "\n").unwrap();
}
