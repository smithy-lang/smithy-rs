{
  "protocols": {
    "common": {
      "request": {
        "header": {
          "readTimeout": "10s"
        },
        "body": {
          "maxBytes": "1 KiB",
          "readTimeouts": {
            "defaultNonPayload": "5s",
            "defaultPayload": "10s",
            "perOperation": {
              "integration.requestlimits#EchoWithOverride": "3s"
            }
          }
        }
      }
    }
  }
}
